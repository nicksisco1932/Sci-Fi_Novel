# Auto detect text files and perform LF normalization
* text=auto

# Keep compiled graphic-novel proof PDFs versioned without oversized Git blobs.
art/graphic_novel/proofs/**/*.pdf filter=lfs diff=lfs merge=lfs -text

# Store newly added or subsequently revised graphic-novel PNG assets in LFS.
art/graphic_novel/**/*.png filter=lfs diff=lfs merge=lfs -text
