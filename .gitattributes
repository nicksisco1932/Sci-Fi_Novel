# Auto detect text files and perform LF normalization
* text=auto

# Preserve the exact bytes of versioned reader packages and their cover artwork.
beta_readers/packages/**/*.pdf binary
beta_readers/assets/*.jpg binary
beta_readers/assets/*.png binary

# Frozen source bytes and manifests must survive checkout without newline conversion.
docs/developmental/manuscript_style_tests/** -text whitespace=cr-at-eol
docs/reader_package/** -text whitespace=cr-at-eol
docs/copy_editor/runs/** -text whitespace=cr-at-eol
beta_readers/packages/** -text whitespace=cr-at-eol
beta_readers/packages/**/*.pdf binary

# Intentional historical Markdown breaks and unified-diff context lines.
docs/developmental/manuscript_style_tests/review_ledger.md whitespace=-blank-at-eol,cr-at-eol
docs/developmental/manuscript_style_tests/*.diff whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
# Development notes use two trailing spaces for intentional Markdown line breaks.
docs/developmental/*.md whitespace=-blank-at-eol

# Beta PDFs are immutable byte artifacts, including ASCII-encoded PDF streams.
output/pdf/Hive_Earth_Beta_Reader*.pdf binary

# Preserve the already-published asset audit's terminal blank line.
art/graphic_novel/ASSET_ECOSYSTEM_MAP_2026-09-04.md whitespace=-blank-at-eof

# Keep compiled graphic-novel proof PDFs versioned without oversized Git blobs.
art/graphic_novel/proofs/**/*.pdf filter=lfs diff=lfs merge=lfs -text

# Store the post-baseline concept batches and recovered experiment PNGs in LFS
# without reclassifying the repository's established graphic-novel PNG history.
art/graphic_novel/concept_sketches/institutions/**/*.png filter=lfs diff=lfs merge=lfs -text
art/graphic_novel/concept_sketches/technology/**/*.png filter=lfs diff=lfs merge=lfs -text
art/graphic_novel/concept_sketches/events-concepts/**/*.png filter=lfs diff=lfs merge=lfs -text
art/graphic_novel/experiments/visual-language-hierarchy/assets/**/*.png filter=lfs diff=lfs merge=lfs -text

# Keep versioned Phase 1 correction candidates in LFS without touching their
# established source assets or rewriting prior PNG history.
art/graphic_novel/**/*phase1*.png filter=lfs diff=lfs merge=lfs -text
art/graphic_novel/**/continuity-sheet-material-refinement-v3*.png filter=lfs diff=lfs merge=lfs -text
art/graphic_novel/**/continuity-sheet-material-refinement-pilot*.png filter=lfs diff=lfs merge=lfs -text
art/graphic_novel/**/phase1-reset/**/*.png filter=lfs diff=lfs merge=lfs -text
art/graphic_novel/**/phase1-reset/*.png filter=lfs diff=lfs merge=lfs -text
art/graphic_novel/chapter_01_wakeup/asset-pack-phase1-reset/*.png filter=lfs diff=lfs merge=lfs -text
